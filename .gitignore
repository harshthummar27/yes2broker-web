# OS
.DS_Store
Thumbs.db

# Environment (never commit secrets — create .env on the server)
.env
.env.*
!.env.example

# PHP / Composer
/vendor
/auth.json
.phpactor.json
.phpunit.result.cache
/.phpunit.cache

# Node
/node_modules
/public/hot

# IDE
/.fleet
/.idea
/.nova
/.vscode/*
!/.vscode/settings.json
/.zed

# Laravel logs & runtime cache
*.log
/storage/*.key
/storage/pail
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# Uploads (property images, promos, etc.) — deploy separately or use admin uploads on live
/public/storage
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore

# Legacy WordPress import files (local only — not needed on production)
/Properties-Export*.csv
/wp_posts.csv
/properties_new.sql
/*.csv
/*.sql

# Archives & local backups
*.zip
*.tar
*.tar.gz
*.bak

# Local dev (Homestead / Valet)
Homestead.json
Homestead.yaml
